{
  "name": "openpub-mcp",
  "version": "0.1.0",
  "description": "stdio MCP server for OpenPub. Publish one Markdown file to dev.to, Hashnode, WordPress, Ghost, Medium, Substack, GitHub Pages, and X Articles from any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openpub-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "prepack": "npm run build",
    "postbuild": "chmod +x dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@openpub/core": "*",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "openpub",
    "mcp",
    "mcp-server",
    "markdown",
    "blog",
    "publish",
    "crosspost",
    "devto",
    "hashnode",
    "medium",
    "ghost",
    "wordpress",
    "substack",
    "x-articles",
    "github-pages"
  ]
}

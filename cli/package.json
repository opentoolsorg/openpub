{
  "name": "openpost-cli",
  "version": "1.0.0",
  "description": "CLI for a self-hosted OpenPost worker — draft, preview, and publish markdown posts to dev.to, Hashnode, Medium, Ghost, WordPress, Substack",
  "license": "ISC",
  "type": "module",
  "bin": {
    "openpost": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "openpost",
    "markdown",
    "blog",
    "publish",
    "devto",
    "hashnode",
    "medium",
    "ghost",
    "wordpress",
    "substack"
  ]
}

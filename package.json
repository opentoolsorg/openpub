{
  "name": "openpub",
  "version": "0.1.0",
  "description": "Write once, publish everywhere. Self-hosted, agent-native cross-posting engine for technical blogs.",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "vitest run __tests__ --exclude '**/.claude/**'",
    "dev:site": "npm run dev --workspace @openpub/site",
    "dev:dashboard": "npm run dev --workspace openpub-dashboard",
    "dev:worker": "npm run dev --workspace @openpub/worker -- --port 8788 --local",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace openpub-dashboard && npm run typecheck --workspace @openpub/site",
    "build": "npm run build --workspaces --if-present",
    "deploy": "npm run build --workspace openpub-dashboard && npm run deploy --workspace @openpub/worker",
    "cli:build": "npm run build --workspace openpub-cli",
    "mcp:build": "npm run build --workspace openpub-mcp",
    "dev": "npm run dev:site & npm run dev:dashboard & npm run dev:worker & wait"
  },
  "keywords": [
    "openpub",
    "markdown",
    "blog",
    "publish",
    "crosspost",
    "mcp",
    "mcp-server",
    "devto",
    "hashnode",
    "medium",
    "ghost",
    "wordpress",
    "substack",
    "x-articles",
    "cloudflare-workers"
  ],
  "author": "princepal9120",
  "homepage": "https://openpub.princslabs.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princepal9120/openpub.git"
  },
  "bugs": {
    "url": "https://github.com/princepal9120/openpub/issues"
  },
  "license": "MIT",
  "files": [
    "packages/core",
    "apps/docs",
    "apps/worker/docs",
    "examples",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}

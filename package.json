{
  "name": "openpub",
  "version": "0.1.0",
  "description": "Write once, publish everywhere. Self-hosted, agent-native cross-posting engine for technical blogs.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm --prefix dashboard run build && wrangler deploy",
    "cli:build": "npm --prefix cli run build",
    "mcp:build": "npm --prefix mcp run build",
    "action:test": "bash test/publish.test.sh"
  },
  "keywords": [
    "openpub",
    "markdown",
    "blog",
    "publish",
    "crosspost",
    "mcp",
    "mcp-server",
    "devto",
    "hashnode",
    "medium",
    "ghost",
    "wordpress",
    "substack",
    "x-articles",
    "cloudflare-workers"
  ],
  "author": "princepal9120",
  "homepage": "https://openpub.princslabs.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princepal9120/openpub.git"
  },
  "bugs": {
    "url": "https://github.com/princepal9120/openpub/issues"
  },
  "license": "MIT",
  "files": [
    "src/core",
    "docs",
    "examples",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["apps/worker/src/**/*.ts", "apps/cli/*.ts", "apps/mcp/*.ts", "packages/core/src/**/*.ts", "__tests__/**/*.ts"]
}
